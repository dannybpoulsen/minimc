{% macro reg_instruction(i) %}
    case MiniMC::Model::InstructionCode::{{i.getName ()}}: {
    	 return Instruction::make<MiniMC::Model::InstructionCode::{{i.getName()}} >(
    	 {%for o in i.getOperands () %}
	       {%if o.isMultiParam () %}
	       instructionValues(values.begin()+{{loop.index0 }},values.end())
	       {%else %}
	       {%if o.isRegister () %}
	       instructionRegister(values.at ({{loop.index0}}))
	       {%else%}
	       instructionValue(values.at ({{loop.index0}}))
	       {%endif %}	
	       {% endif %}
	       {%if not loop.last %}, {%endif%} 
	 {%endfor %}
	 );
    }
{% endmacro %}


{% macro reg_instructions(instructions) %}
{%for i in instructions %}
    {{reg_instruction(i)}}
{% endfor %}
{% endmacro %}


{% macro bin_ass_convertible_instruction(i) %}
    case MiniMC::Model::InstructionCode::{{i.getName ()}}: {
        MiniMC::Model::Value_ptr op = std::make_shared<MiniMC::Model::{{i.getName ()}}Expr> (instructionValue(values.at(1)),instructionValue(values.at(2)));
	   return makeInstruction (MiniMC::Model::InstructionCode::Assign,{instructionRegister(values.at(0)),op});
	 }

{% endmacro %}


{% macro bin_instructions(instructions) %}
{% for i in instructions %}
       	 {%if i.isAssignConvertible () %}
	 {{bin_ass_convertible_instruction(i)}}
	 {%else %}
	 {{reg_instruction(i)}}	 
 	 {%endif%}   	 
{% endfor %}
{% endmacro %}




inline MiniMC::Model::Value_ptr instructionValue(const MiniMC::Model::InstructionArgument& arg) {
  if (auto value = std::get_if<MiniMC::Model::Value_ptr>(&arg)) return *value;
  throw MiniMC::Support::Exception("Instruction argument is not a value");
}

inline MiniMC::Model::Register_ptr instructionRegister(const MiniMC::Model::InstructionArgument& arg) {
  if (auto reg = std::get_if<MiniMC::Model::Register_ptr>(&arg)) return *reg;
  return MiniMC::Model::getRegister(instructionValue(arg));
}

template<class Iterator>
std::vector<MiniMC::Model::Value_ptr> instructionValues(Iterator begin, Iterator end) {
  std::vector<MiniMC::Model::Value_ptr> values;
  for (; begin != end; ++begin) values.push_back(instructionValue(*begin));
  return values;
}

Instruction makeInstruction (InstructionCode code,std::vector<MiniMC::Model::InstructionArgument> values) {
	    switch (code) {
	    {%for g in ISA.getGroups () %}
	    {%if g.getName () == "TAC" or g.getName () == "Comparison"%}
	    {{bin_instructions (g.getInstructions ()) }}
	    {%else %}
	    {{reg_instructions(g.getInstructions())}}	    
	    {%endif%}
	    {%endfor%}
	    default:
	    std::unreachable();
	    }
}