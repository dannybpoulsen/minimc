#ifndef _TYPECHECK__
#define _TYPECHECK__

#include "minimc/model/valuevisitor.hpp"
#include "minimc/model/cfg.hpp"
#include "minimc/support/feedback.hpp"
#include "minimc/support/overload.hpp"

#include <iostream>

namespace MiniMC {
  namespace Model {
    namespace Checkers {
      /**
	   * Typecheck the progrm \p prgm.
	   
	   */
      struct TypeChecker  {
        TypeChecker(MiniMC::Support::Messager messager) : messager(messager)  {}
	bool Check(const MiniMC::Model::Program& prgm );
	bool Check(MiniMC::Model::Function&);
	MiniMC::Model::Type_ptr  CheckType ( MiniMC::Model::Value& v) const  {
	MiniMC::Support::SubProgresSenderClearer<std::string> clear (std::string{"Typechecking"});			 
	auto type = MiniMC::Model::visitValue (*this, v); 
	return type;
	}
		
	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Register& i) const  {
	  return i.getType();
	}
	
	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Bool& i) const  {
	  i.setType(MiniMC::Model::BoolType::get());
	  return i.getType();
	}

	

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::I8Integer& i) const  {
	  i.setType(MiniMC::Model::I8Type::get());
	  return i.getType();
	}
	
	MiniMC::Model::Type_ptr operator() (MiniMC::Model::I16Integer& i) const  {
	  i.setType(MiniMC::Model::I16Type::get());
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::I32Integer& i) const  {
	  i.setType(MiniMC::Model::I32Type::get());
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::I64Integer& i) const  {
	  i.setType(MiniMC::Model::I64Type::get());
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Pointer& i) const {
	  i.setType(MiniMC::Model::PointerType::get());
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Pointer32& i) const  {
	  i.setType(MiniMC::Model::Pointer32Type::get());
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::SymbolicConstant& i) const  {
	  auto type = std::visit (MiniMC::Support::Overload {
	        	  [](const MiniMC::Model::Register_wptr&r ) ->MiniMC::Model::Type_ptr {return r.lock()->getType();},
      	  		  [](const MiniMC::Model::Function_wptr&) ->MiniMC::Model::Type_ptr{return MiniMC::Model::PointerType::get();},
     	  		  [](const MiniMC::Model::Location_wptr&) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();},
	  		  [](const MiniMC::Model::HeapBlock_wptr&) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();},
	  		  [](const std::monostate& ) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();}
	  	}
	    ,i.getValue().getUserData());
	  i.setType(type);
	  return i.getType();
	}
	
	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Undef& i) const  {
	  return i.getType();
	}

	MiniMC::Model::Type_ptr operator() (MiniMC::Model::AggregateConstant& i) const  {
	  i.setType(MiniMC::Model::AggregateType::get(i.getSize()));
	  return i.getType();
	}


	MiniMC::Model::Type_ptr operator() (MiniMC::Model::PtrToPtr32Expr& i) const ;
	MiniMC::Model::Type_ptr operator() (MiniMC::Model::Ptr32ToPtrExpr& i) const ;
						 			     
						   
	{% for i in ISA.getPseudoInstructions () %}
	{%if i.isAssignConvertible () %}
	MiniMC::Model::Type_ptr  operator() ({{i.getName ()}}Expr& ) const;
	
	{%endif %}
	{%endfor %}
		
      private:
	template<class Inst>
	bool doCheck(const Inst&, const MiniMC::Model::Instruction&, const MiniMC::Model::Type_ptr&);
	

	const MiniMC::Model::Program* prgm{nullptr};
	mutable MiniMC::Support::Messager messager;
      };
      
    } // namespace Checkers
  }   // namespace Model
} // namespace MiniMC

#endif
 
