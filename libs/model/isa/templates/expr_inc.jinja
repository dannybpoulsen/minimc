    template<class T,bool consts>
    using CType = typename std::conditional<consts,const T,T>::type; 
    
    template<class E,class Res = void,bool cconsts =true>
    concept TValueVisitator = requires(const E e,
				    CType<MiniMC::Model::I8Integer,cconsts>& i8,
				    CType<MiniMC::Model::I16Integer,cconsts> i16,
				    CType<MiniMC::Model::I32Integer,cconsts> i32,
				    CType<MiniMC::Model::I64Integer,cconsts> i64,
				    CType<MiniMC::Model::Bool,cconsts> b,
				    CType<MiniMC::Model::Pointer,cconsts> ptr,
				    CType<MiniMC::Model::Pointer32,cconsts> ptr32,
				    CType<MiniMC::Model::AggregateConstant,cconsts> aggrc,
				    CType<MiniMC::Model::Register,cconsts> reg,
				    CType<MiniMC::Model::Undef,cconsts> und,
				    CType<MiniMC::Model::SymbolicConstant,cconsts> sc,
				    CType<Ptr32ToPtrExpr,cconsts> ptr32ptr,
				    CType<PtrToPtr32Expr,cconsts> ptrptr32,
				    
				    {%for N in all_bin_ops+all_unary_ops+cast_ops+aggr_ops %}
        			    CType<MiniMC::Model::{{N.getName()}}Expr,cconsts> o{{loop.index}} {%if not loop.last %}, {%endif%}
				    {%endfor%}
    ) {
      {e(i8)}->std::convertible_to<Res>;
      {e(i16)}->std::convertible_to<Res>;
      {e(i32)}->std::convertible_to<Res>;
      {e(i64)}->std::convertible_to<Res>;
      {e(b)}->std::convertible_to<Res>;
      {e(ptr)}->std::convertible_to<Res>;
      {e(ptr32)}->std::convertible_to<Res>;
      {e(aggrc)}->std::convertible_to<Res>;
      {e(reg)}->std::convertible_to<Res>;
      {e(und)}->std::convertible_to<Res>;
      {e(sc)}->std::convertible_to<Res>;
      {e(ptr32ptr)}->std::convertible_to<Res>;
      {e(ptrptr32)}->std::convertible_to<Res>;
      
      {%for N in all_bin_ops+all_unary_ops+cast_ops+aggr_ops %}{e(o{{loop.index}}) }->std::convertible_to<Res>;
           {%endfor%}
    
    };

    template<class E,class Res = void>
    concept ValueVisitator = TValueVisitator<E,Res,true>;

    template<class E,class Res = void>
    concept MutableValueVisitator = TValueVisitator<E,Res,false>;
    
    
    template <class Res,bool c, TValueVisitator<Res,c> F>
    auto visitValueT(F&& f,CType<MiniMC::Model::Value,c>& v)  {
      switch (v.type_t ()) {
      case ValueInfo<I8Integer>::type_t ():
	return f (static_cast<CType<I8Integer,c>&> (v));
	break;
      case ValueInfo<I16Integer>::type_t ():
	return f (static_cast<CType<I16Integer,c>&> (v));
	break;
      case ValueInfo<I32Integer>::type_t ():
	return f (static_cast<CType<I32Integer,c>&> (v));
	break;
      case ValueInfo<I64Integer>::type_t ():
	return f (static_cast<CType<I64Integer,c>&> (v));
	break;
      case ValueInfo<Bool>::type_t ():
	return f (static_cast<CType<Bool,c>&> (v));
	break;
      case ValueInfo<Pointer>::type_t ():
	return f (static_cast<CType<Pointer,c>&> (v));
	break;
      case ValueInfo<Pointer32>::type_t ():
	return f (static_cast<CType<Pointer32,c>&> (v));
	break;
      case ValueInfo<AggregateConstant>::type_t ():
	return f (static_cast<CType<AggregateConstant,c>&> (v));
	break;
      case ValueInfo<Register>::type_t ():
	return f (static_cast<CType<Register,c>&> (v));
	break;
      case ValueInfo<Undef>::type_t ():
	return f (static_cast<CType<Undef,c>&> (v));
	break;
      case ValueInfo<SymbolicConstant>::type_t ():
	return f (static_cast<CType<SymbolicConstant,c>&> (v));
	break;
     case ValueInfo<LoadExpr>::type_t ():
	return f (static_cast<CType<LoadExpr,c>&> (v));
	break;
     case ValueInfo<StoreExpr>::type_t ():
	return f (static_cast<CType<StoreExpr,c>&> (v));
     case ValueInfo<Ptr32ToPtrExpr>::type_t ():
	return f (static_cast<CType<Ptr32ToPtrExpr,c>&> (v));
       case ValueInfo<PtrToPtr32Expr>::type_t ():
	return f (static_cast<CType<PtrToPtr32Expr,c>&> (v));
	   {%for N in all_bin_ops+all_unary_ops+cast_ops+pointer_ops+aggr_ops %}case ValueInfo<{{N.getName()}}Expr>::type_t ():
       	     return f (static_cast<CType<{{N.getName()}}Expr,c>&> (v));
	     break;
	   {%endfor%}    
default:		
#ifdef NDEBUG
	std::unreachable();
#else
	throw MiniMC::Support::Exception ("Missing category");
#endif
        }
      
    }

    template <class Res,ValueVisitator<Res> F>
    auto visitValue(F&& f,const MiniMC::Model::Value& v) {
      return visitValueT<Res,true,F>(std::forward<F>(f),v);
    }

    template <class Res,MutableValueVisitator<Res> F>
    auto visitValue(F&& f,MiniMC::Model::Value& v) {
      return visitValueT<Res,false,F>(std::forward<F>(f),v);
    }

    
    class ExpressionBuilder {
    public:		    
      ExpressionBuilder()  {}
      void I8 (MiniMC::BV8 v)  {stack.push (I8Integer::make(v));}
      void I16 (MiniMC::BV16 v)  {stack.push (I16Integer::make(v));}
      void I32 (MiniMC::BV32 v)  {stack.push (I32Integer::make(v));}
      void I64 (MiniMC::BV64 v)  {stack.push (I64Integer::make(v));}
      void symbol (MiniMC::Model::Symbol s) {stack.push(SymbolicConstant::make(s));}      

      {%for N in all_bin_ops %}
      void {{N.getName()}} () {
      	   auto r = stack.top();stack.pop ();
	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<{{N.getName()}}Expr>(l,r));
       }
       {%endfor%}    

       void PtrAdd () {
      	   auto r = stack.top();stack.pop ();
	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<PtrAddExpr>(l,r));
       }

       void PtrSub () {
      	   auto r = stack.top();stack.pop ();
	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<PtrSubExpr>(l,r));
       }

       void Ptr32ToPtr () {
      	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<Ptr32ToPtrExpr>(l));
       }

       void PtrToPtr32 () {
      	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<PtrToPtr32Expr>(l));
       }

       void Load () {
       	    auto addr = stack.top();stack.pop();
	    auto mem = stack.top();stack.pop();
	    auto type = types.top();types.pop();
	    stack.push(std::make_shared<LoadExpr> (mem,addr,type));
       }
       

       void Store () {
       	    auto storee = stack.top();stack.pop();
	    auto addr = stack.top();stack.pop();
	    auto mem = stack.top();stack.pop();
	    
	    stack.push(std::make_shared<StoreExpr> (mem,addr,storee));
       }

       void InsertValue () {
       	    auto insertee = stack.top();stack.pop();
	    auto offset = stack.top();stack.pop();
	    auto aggr = stack.top();stack.pop();
	    stack.push(std::make_shared<InsertValueExpr> (aggr,offset,insertee));
       }

       void ExtractValue () {
       	    auto offset = stack.top();stack.pop();
	    auto aggr = stack.top();stack.pop();
	    auto type = types.top();types.pop();
	    stack.push(std::make_shared<ExtractValueExpr> (aggr,offset,type));
       }

      {%for N in cast_ops %}
      void {{N.getName()}} () {
      	   auto f = stack.top();stack.pop ();
	   auto type = types.top();types.pop(); 
	   stack.push(std::make_shared<{{N.getName()}}Expr>(f,type));
       }
       {%endfor%}    

     {%for N in all_unary_ops %}
           void {{N.getName()}} () {
      	   auto f = stack.top();stack.pop ();
	   stack.push(std::make_shared<{{N.getName()}}Expr>(f));	
       }
       {%endfor%}

      void pushI8Type () {
      	   types.push (I8Type::get());
	   }	      

     void pushI16Type () {
      	   types.push (I16Type::get());
      }

      void pushI32Type () {
      	   types.push (I32Type::get());
      }

      void pushI64Type () {
      	   types.push (I64Type::get());
      }

      void pushPointerType () {
      	   types.push (PointerType::get());
      }     
      
      void pushAggregateType (std::size_t n) {
      	   types.push (AggregateType::get(n));
      }     

      auto& operator<< (Value_ptr ptr) {
      	    stack.push(std::move(ptr));
	    return *this;
      }

      auto& operator<< (Type_ptr ptr) {
      	    types.push(std::move(ptr));
	    return *this;
      }
      
      auto get() {auto val = stack.top(); stack.pop(); return val;}
    private:
      std::stack<Value_ptr> stack;
      std::stack<Type_ptr> types;
};			  