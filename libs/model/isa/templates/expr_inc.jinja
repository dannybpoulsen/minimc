template <class F, class... Vs>
struct Dispatcher {
  template<class... T>
  static auto dispatch (F f,Vs&... vs) {return std::invoke(f,(vs.template as<T> ())...);}
};

template <class F, class... Vs>
struct LocateDispatcher {
  
  template<class VV,class... VVs>
  struct Locate_impl {
    template<class... T>
    static auto locate_impl (VV& vv, VVs&... vs) {
      switch (vv.type_t ()) {
	{%for N in plain_non_generated_names %}case ValueInfo::type_t<{{N}}> ():
	if constexpr (sizeof...(VVs) == 0)
	    return &Dispatcher<F,Vs...>::template dispatch<T...,{{N}}>;
	else return Locate_impl<VVs...>::template locate_impl<T...,{{N}}> (vs...);    	
	{%endfor%}
	{%for N in ISA.getExpressionsFromGroups(["TAC","Comparison","Unary","Cast","Pointer","Aggregate","memory"]) %}case ValueInfo::type_t<{{N.getName()}}Expr> ():
	if constexpr (sizeof...(VVs) == 0)
	  return &Dispatcher<F,Vs...>::template dispatch<T...,{{N.getName()}}Expr>;
	else return Locate_impl<VVs...>::template locate_impl<T...,{{N.getName()}}Expr> (vs...);    	
	{%endfor%}
default:		
#ifdef NDEBUG
	std::unreachable();
#else
	throw MiniMC::Support::Exception ("Missing category");
#endif
      }
      
    }
  };

  
  
  static auto locate (Vs&... vs) {
    return Locate_impl<Vs...>::locate_impl (vs...);
  }
  
};


template <class F,class... V>
auto visitValueT(F&& f,V&... v)  {
  return (*LocateDispatcher<F,V...>::locate (v...)) (f,v...);
}



template <class F, class... Vals>
auto visitValue(F&& f,Vals&&... v) {
  return visitValueT(std::forward<F>(f),std::forward<Vals>(v)...);
}


template <class F>
void visitSubExpressions(F&& f,const MiniMC::Model::Value& vv) {
      switch (vv.type_t ()) {
      	{%for N in plain_non_generated_names %}case ValueInfo::type_t<{{N}}> ():
	 f(vv.template as<{{N}}> ());
	break;
	{%endfor%}
	{%for N in ISA.getExpressionsFromGroups(["TAC","Comparison","Unary","Cast","Pointer","Aggregate","memory"]) %}case ValueInfo::type_t<{{N.getName()}}Expr> ():
	{
		auto& nn = vv.template as<{{N.getName()}}Expr> ();
		{%for K in N.getNonResOperands () %}
		visitSubExpressions (f,nn.{{K.getName()}} ());
		{%endfor %}
		f(nn);
		break;
		
	}	
	{%endfor%}	  

     }    
}
    
    class ExpressionBuilder {
    public:		    
      ExpressionBuilder()  {}
      void I8 (MiniMC::BV8 v)  {stack.push (I8Integer::make(v));}
      void I16 (MiniMC::BV16 v)  {stack.push (I16Integer::make(v));}
      void I32 (MiniMC::BV32 v)  {stack.push (I32Integer::make(v));}
      void I64 (MiniMC::BV64 v)  {stack.push (I64Integer::make(v));}
      void symbol (MiniMC::Model::Symbol s) {stack.push(SymbolicConstant::make(s));}      

      {%for N in ISA.getExpressionsFromGroups(["TAC","Comparison","Pointer","memory","Unary"]) %}
      void {{N.getName()}} () {
      	   {%for I in N.getNonResOperands() | reverse %}
	   	 auto {{ I.getName() }} = stack.top();stack.pop();
	   {%endfor %}
	   /*auto r = stack.top();stack.pop ();
	   auto l = stack.top();stack.pop ();*/
	   stack.push(std::make_shared<{{N.getName()}}Expr>(
		{%for I in N.getNonResOperands() %}
	   	 {{ I.getName() }}
		 {%if not loop.last %}, {%endif%}
		 {% endfor %}
	   
		)
	   
	   );
       }
       {%endfor%}    


       void Ptr32ToPtr () {
      	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<Ptr32ToPtrExpr>(l));
       }

       void PtrToPtr32 () {
      	   auto l = stack.top();stack.pop ();
	   stack.push(std::make_shared<PtrToPtr32Expr>(l));
       }

       void Load () {
       	    auto addr = stack.top();stack.pop();
	    auto mem = stack.top();stack.pop();
	    auto type = types.top();types.pop();
	    stack.push(std::make_shared<LoadExpr> (mem,addr,type));
       }
       

       void Store () {
       	    auto storee = stack.top();stack.pop();
	    auto addr = stack.top();stack.pop();
	    auto mem = stack.top();stack.pop();
	    
	    stack.push(std::make_shared<StoreExpr> (mem,addr,storee));
       }

        void InsertValue () {
       	    auto insertee = stack.top();stack.pop();
	    auto offset = stack.top();stack.pop();
	    auto aggr = stack.top();stack.pop();
	    stack.push(std::make_shared<InsertValueExpr> (aggr,offset,insertee));
       }

       void ExtractValue () {
       	    auto offset = stack.top();stack.pop();
	    auto aggr = stack.top();stack.pop();
	    auto type = types.top();types.pop();
	    stack.push(std::make_shared<ExtractValueExpr> (aggr,offset,type));
       }       

      {%for N in ISA.getExpressionsFromGroups(["Cast"]) %}
      void {{N.getName()}} () {
      	   auto f = stack.top();stack.pop ();
	   auto type = types.top();types.pop(); 
	   stack.push(std::make_shared<{{N.getName()}}Expr>(f,type));
       }
       {%endfor%}    

     
      void pushI8Type () {
      	   types.push (I8Type::get());
	   }	      

     void pushI16Type () {
      	   types.push (I16Type::get());
      }

      void pushI32Type () {
      	   types.push (I32Type::get());
      }

      void pushI64Type () {
      	   types.push (I64Type::get());
      }

      void pushPointerType () {
      	   types.push (PointerType::get());
      }     
      
      void pushAggregateType (std::size_t n) {
      	   types.push (AggregateType::get(n));
      }     

      auto& operator<< (Value_ptr ptr) {
      	    stack.push(std::move(ptr));
	    return *this;
      }

      auto& operator<< (Type_ptr ptr) {
      	    types.push(std::move(ptr));
	    return *this;
      }
      
      auto get() {auto val = stack.top(); stack.pop(); return val;}
    private:
      std::stack<Value_ptr> stack;
      std::stack<Type_ptr> types;

};

