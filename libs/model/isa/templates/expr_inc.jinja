}

template <class T>
const T& Value::as () const {
  if (type_t () == ValueInfo::type_t<T> ())
    return static_cast<const T&> (*this);
  else throw
	 MiniMC::Support::Exception ("Error");
}

template<class T>
concept Integer = std::is_same_v<T,I8Integer> || std::is_same_v<T,I16Integer> || std::is_same_v<T,I32Integer>  || std::is_same_v<T,I64Integer>;
