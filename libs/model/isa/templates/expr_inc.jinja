    template<type_id_t i , class T, class F, class... Args>
    constexpr auto  auto_index ()  {
      if constexpr ( std::is_same_v<T,F>) {
	return i;
      }
      else {
	return auto_index<i+1,T,Args...> ();
      }
    }
    
    template<type_id_t i , class T, class F>
    constexpr auto  auto_index ()  {
      if constexpr ( std::is_same_v<T,F>) {
	return i;
      }
      else {
	return []<bool b = false> {static_assert (b);}();
      }
    }


    template <class T>
    struct ValueInfo {
      static constexpr auto type_t () {
	return auto_index<0,T,
			  I8Integer,
			  I16Integer,
			  I32Integer,
			  I64Integer,
			  Bool,
			  Pointer,
			  Pointer32, 
			  AggregateConstant,
			  Register,
			  Undef,
			  SymbolicConstant,
			  LoadExpr,
			  StoreExpr,
			  Ptr32ToPtrExpr,
			  PtrToPtr32Expr,
			  ExtractValueExpr,
			  			  /*InsertValueExpr,*/
			  {% for N in all_bin_ops+all_unary_ops+cast_ops+pointer_ops+aggr_ops %}{{N.getName()}}Expr{% if not loop.last %},{%endif%}
			  {% endfor %}
			  	  
			  > ();
      }
    };
    
    
    template <class T, bool is_bool>
    inline TConstant<T, is_bool>::TConstant(T val) : Constant(ValueInfo<TConstant<T, is_bool>>::type_t()),
                                                     value(val) {
						     setType(_inner_type());
    }
    
    inline SymbolicConstant::SymbolicConstant (MiniMC::Model::Symbol val)  : Constant(ValueInfo<SymbolicConstant>::type_t()), symbol(val) {
    	    auto type = std::visit (MiniMC::Support::Overload {
	        	  [](const MiniMC::Model::Register_wptr&r ) ->MiniMC::Model::Type_ptr {return r.lock()->getType();},
      	  		  [](const MiniMC::Model::Function_wptr&) ->MiniMC::Model::Type_ptr{return MiniMC::Model::PointerType::get();},
     	  		  [](const MiniMC::Model::Location_wptr&) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();},
	  		  [](const MiniMC::Model::HeapBlock_wptr&) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();},
	  		  [](const std::monostate& ) ->MiniMC::Model::Type_ptr {return MiniMC::Model::PointerType::get();}
	  	}
	    ,val.getUserData());
	    setType(type);
    }

