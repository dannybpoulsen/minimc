template<class... Args>      
struct AutoIndexer {
  template<class T>
  static constexpr auto index () {return index_impl<0,T,Args...> ();}

private:
  template<type_id_t i , class T, class F, class... args>
  static constexpr auto  index_impl ()  {
    if constexpr ( std::is_same_v<T,F>) {
      return i;
    }
    else {
      if constexpr (sizeof...(args) == 0)
	return []<bool b = false> {static_assert (b);}();
      else {
      
	return index_impl<i+1,T,args...> ();
      }
    }
  }

};


