      class MustBeLarger : public InstrTypeError{
      public:
	MustBeLarger (MiniMC::Model::Instruction instr, MiniMC::Model::Type_ptr t1,MiniMC::Model::Type_ptr t2 ) : InstrTypeError (std::move(instr)),t1(t1),t2(t2) {}
	virtual std::ostream& to_string (std::ostream& os) const {
	  return os << loc.format (getInstr (),*t1,*t2);
	}
	
      private:
	MiniMC::Support::Localiser loc{"For Instruction '%1%': '%2%' must be of larger size thant %3%"};
	MiniMC::Model::Type_ptr t1;
	MiniMC::Model::Type_ptr t2;
	
      };

      class MustBeConstant : public InstrTypeError {
      public:
	MustBeConstant (MiniMC::Model::Instruction instr, MiniMC::Model::Value_ptr t1 ) : InstrTypeError (std::move(instr)),val(t1) {}
	virtual std::ostream& to_string (std::ostream& os) const {
	  return os << loc.format (getInstr (),*val);
	}
      private:
	MiniMC::Support::Localiser loc{"For Instruction '%1%': '%2%' must be constant"};
	
	Value_ptr val;
      };

{%macro type_constraint(t) %}
  (
  {%for k in t.getTypeD () %}
  {%if k =="Integer" %}
    ({{t.getName()}}->isInteger())
  {%elif k =="Bool" %}
    ({{t.getName()}}->getTypeID () == MiniMC::Model::TypeID::Bool)
  {%elif k =="Pointer" %}
    ({{t.getName()}}->getTypeID () == MiniMC::Model::TypeID::Pointer )
  {%elif ok == "Pointe32" %}
    ({{t.getName()}}->getTypeID () == MiniMC::Model::TypeID::Pointer32)
  {%else %}
    true
  {%endif%}
  {%if not loop.last %}
    ||
  {%endif %}
{%endfor %}
)
{%endmacro%}

{%macro size_constraint(l,r,c) %}
	if (!({{l.getName()}}->getSize () {{c}}  {{r.getName()}}->getSize ())) {
	   messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' be '%3%' '%2%'"}.format (*{{l.getName()}},*{{r.getName()}},"{{c}}")};
	   return nullptr;
	   }
{%endmacro %}

{%macro size_constraints(i) %}
	{%if i.getTypeSizeRestrictions () %}
	{{ size_constraint(i.getTypeSizeRestrictions ().getLesser(),i.getTypeSizeRestrictions ().getGreater(),i.getTypeSizeRestrictions().getCMP ()) }}
	{%endif%}
{%endmacro%}

{%macro tac_instruction(i) %}
 MiniMC::Model::Type_ptr  TypeChecker::operator() ({{i.getName()}}Expr& expr)  const {
	{%for o in i.getNonResOperands () %}MiniMC::Model::Type_ptr {{o.getName()}}_ty = CheckType(expr.{{o.getName()}}());	
        {%endfor %}
	{%for t,tp in i.getTypes ().items() %}
	  {%for o in tp.NonResoperands () %}{%if loop.first %} MiniMC::Model::Type_ptr {{t}} = {{o.getName ()}}_ty;
	  {%else %}
	    if ({{t}} != {{o.getName()}}_ty) {
	    messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' must have type '%2%'"}.format (expr.{{o.getName()}}(),*{{t}})};
	    return nullptr;
	    }
	  {%endif %}
	{%endfor %}

	if (!{{type_constraint(tp) }}) {
	messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' does not meet it's type constraints"}.format (*{{tp.getName()}})};
	return nullptr;
	}
	
	{%endfor %}
	{{size_constraints(i)}}
	{%if i.getResOperand () %}
	  expr.setType ({{i.getResOperand ().getType().getName ()}});
        {%endif%}
	return expr.getType();
}
      {%endmacro %}

      {%macro comparison_instruction(i) %}
 MiniMC::Model::Type_ptr  TypeChecker::operator() ({{i.getName()}}Expr& expr)  const {
	{%for o in i.getNonResOperands () %}MiniMC::Model::Type_ptr {{o.getName()}}_ty = CheckType(expr.{{o.getName()}}());	
        {%endfor %}
	{%for t,tp in i.getTypes ().items() %}
	  {%for o in tp.NonResoperands () %}{%if loop.first %} MiniMC::Model::Type_ptr {{t}} = {{o.getName ()}}_ty;
	  {%else %}
	    if ({{t}} != {{o.getName()}}_ty) {
	    messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' must have type '%2%'"}.format (expr.{{o.getName()}}(),*{{t}})};
	    return nullptr;
	    }
	  {%endif %}
	{%endfor %}
	{%if tp.NonResoperands () |length > 0 %} 
	  if (!{{type_constraint(tp) }}) {
	  messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' does not meet it's type constraints"}.format (*{{tp.getName()}})};
	  return nullptr;
	  }
	  {%endif %}
	
	{%endfor %}
	{{size_constraints(i)}}	
	{%if i.getResOperand () %}
	  expr.setType (MiniMC::Model::BoolType::get());
        {%endif%}
	return expr.getType();
	}
      {%endmacro %}

      {%macro cast_instruction(i) %}
	MiniMC::Model::Type_ptr  TypeChecker::operator() ({{i.getName()}}Expr& expr)  const {
	{%for o in i.getNonResOperands () %}MiniMC::Model::Type_ptr {{o}}_ty = CheckType(expr.getFrom ());	
        {%endfor %}
	

	{%for t,tp in i.getTypes ().items() %}
	  {%for o in tp.NonResoperands () %}{%if loop.first %} MiniMC::Model::Type_ptr {{t}} = {{o.getName ()}}_ty; 
	  {%endif %}
	  {%endfor%}
	  {%for o in tp.Resoperands () %}{%if loop.first %} MiniMC::Model::Type_ptr {{t}} = expr.getToType (); 
	  {%endif %}
	  {%endfor %}
	{%if tp.NonResoperands() | length > 0 %} 
	  if (!{{type_constraint(tp) }}) {
	  messager << MiniMC::Support::TError<std::string> {MiniMC::Support::Localiser{"'%1%' does not meet it's type constraints"}.format (*{{tp.getName()}})};
	  return nullptr;
	}
	  {%endif %}
	{%endfor %}
	{{size_constraints(i)}}	
	
	
	
	
	
	
	expr.setType (expr.getToType ());
	return expr.getType();
	}
