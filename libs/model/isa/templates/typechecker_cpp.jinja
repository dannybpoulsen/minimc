       MiniMC::Model::Type_ptr TypeChecker::operator() (MiniMC::Model::LoadExpr& expr) const  {
       	auto lty = CheckType(expr.addr());
	
	MiniMC::Model::Type_ptr res = nullptr;;
	if (lty->getTypeID () == MiniMC::Model::TypeID::Pointer ) {
	  res = expr.getToType();
	}
	else {
	  messager << MustBePointerExpr{expr.addr()};
	}
	expr.setType (res);
	return res;

      }

      MiniMC::Model::Type_ptr TypeChecker::operator() (MiniMC::Model::StoreExpr& expr) const  {
       	auto addrty = CheckType(expr.addr());
	auto storeto = CheckType(expr.storeto());
	
	MiniMC::Model::Type_ptr res = nullptr;;
	if (addrty->getTypeID () == MiniMC::Model::TypeID::Pointer &&
	    storeto->getTypeID () == MiniMC::Model::TypeID::Memory
	    ) {	    
	  res = storeto;
	}
	else {	
	     messager << MustBePointerExpr{expr.addr()};
	} 
	expr.setType (res);
	return res;

      }
      
      MiniMC::Model::Type_ptr  TypeChecker::operator() (MiniMC::Model::LogNotExpr& expr) const  {
      	auto lty = CheckType(expr.op1());
	
	MiniMC::Model::Type_ptr res = nullptr;;
	if (lty->getTypeID () == MiniMC::Model::TypeID::Bool ) {
	  res = MiniMC::Model::BoolType::get();//tfactory->makeBoolType ();
	}
	else {
	  messager << MustBeBoolExpr{expr.op1()};
	}
	expr.setType (res);
	return res;
	  
      }

      MiniMC::Model::Type_ptr  TypeChecker::operator() (MiniMC::Model::NotExpr& expr) const  {
	auto lty = CheckType(expr.op1());
	
	MiniMC::Model::Type_ptr res = nullptr;;
	if (lty->isInteger() ) {
	  res = lty;
	}
	else {
	  messager << MustBeIntegerExpr{expr.op1()};
	}
	expr.setType (res);
	return res;
	  
      }

